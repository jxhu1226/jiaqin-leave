page {
  background: #f6f4ef;
  color: #24312c;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
}

view, text, button, input, textarea, picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.tab-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));
}

.sub-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fffcf7;
  border: 1rpx solid #e4dfd6;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.card-hover {
  background: #f7f3ea;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.muted {
  color: #6d675f;
  font-size: 24rpx;
}

.lede {
  color: #6d675f;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.label {
  color: #6d675f;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.hint {
  color: #6d675f;
  font-size: 26rpx;
  text-align: center;
  padding: 32rpx 0;
}

.empty {
  padding: 48rpx 12rpx 12rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tag {
  font-size: 22rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
}

.tag-pending {
  color: #8a5a12;
  background: #f8f1e2;
}

.tag-approved {
  color: #0f6e56;
  background: #e7f3ee;
}

.tag-rejected {
  color: #9d3b32;
  background: #f8ecea;
}

.tag-withdrawn {
  color: #6d675f;
  background: #efece6;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  flex: none;
}

.dot-personal { background: #3d6b99; }
.dot-sick { background: #c44536; }
.dot-annual { background: #0f6e56; }
.dot-lieu { background: #b07d2a; }
.dot-other { background: #8a8378; }

.c-personal { color: #3d6b99; }
.c-sick { color: #a33b32; }
.c-annual { color: #0f6e56; }
.c-lieu { color: #8a5a2b; }
.c-other { color: #6d675f; }

.btn-primary,
.btn-plain,
.btn-ghost {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary {
  background: #0f6e56;
  color: #fffcf7;
}

.btn-plain {
  background: #fffcf7;
  color: #24312c;
  border: 1rpx solid #d9d3c8;
}

.btn-ghost {
  background: #fffcf7;
  color: #9d3b32;
  border: 1rpx solid #e7c8c4;
}

.btn-primary[disabled] {
  background: #9bb8ad;
  color: #fffcf7;
}

.btn-hover {
  opacity: 0.82;
}

.block {
  width: 100%;
  display: block;
}

.sm {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.input,
.textarea,
.date-box {
  background: #f6f4ef;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #24312c;
  width: 100%;
}

.textarea {
  min-height: 180rpx;
  line-height: 1.5;
}

.ph {
  color: #9a9388;
}

.banner {
  background: #f8f1e2;
  color: #8a5a12;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}

.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fffcf7;
  border-top: 1rpx solid #e4dfd6;
  z-index: 20;
}

.footer-actions {
  display: flex;
}

.footer-actions button {
  flex: 1;
  margin-right: 16rpx;
}

.footer-actions button:last-child {
  margin-right: 0;
}

.footer-spacer {
  height: 160rpx;
}

.type-name {
  display: flex;
  align-items: center;
  font-weight: 600;
  font-size: 30rpx;
}

.spinner {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #e4dfd6;
  border-top-color: #0f6e56;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
