.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.month-mid {
  text-align: center;
}

.month-title {
  font-size: 36rpx;
  font-weight: 600;
}

.today-link {
  color: #0f6e56;
  font-size: 24rpx;
}

.month-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #fffcf7;
  border: 1rpx solid #e4dfd6;
  font-size: 40rpx;
  color: #24312c;
}

.summary {
  color: #6d675f;
  font-size: 24rpx;
  margin: 8rpx 0 16rpx;
}

.cal {
  background: #fffcf7;
  border: 1rpx solid #e4dfd6;
  border-radius: 20rpx;
  padding: 8rpx 4rpx 12rpx;
}

.week,
.grid {
  display: flex;
  flex-wrap: wrap;
}

.week-cell,
.day {
  width: 14.2857%;
}

.week-cell {
  text-align: center;
  font-size: 22rpx;
  color: #6d675f;
  padding: 12rpx 0 8rpx;
}

.week-cell.weekend,
.day.weekend .num {
  color: #a3988c;
}

.day {
  min-height: 128rpx;
  padding: 6rpx 4rpx 8rpx;
}

.day.selected {
  background: #e7f3ee;
  border-radius: 12rpx;
}

.day.out {
  min-height: 128rpx;
}

.num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  margin: 0 auto 4rpx;
  text-align: center;
  font-size: 24rpx;
  border-radius: 999rpx;
}

.num.today,
.day.weekend .num.today {
  background: #0f6e56;
  color: #fffcf7;
}

.who {
  padding: 0 2rpx;
}

.who-name {
  display: block;
  font-size: 18rpx;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  text-align: center;
}

.more {
  font-size: 18rpx;
  color: #6d675f;
  text-align: center;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx 0 8rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  color: #6d675f;
}

.panel {
  margin-top: 8rpx;
  background: #fffcf7;
  border: 1rpx solid #e4dfd6;
  border-radius: 20rpx;
  padding: 24rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-day {
  color: #6d675f;
  font-size: 26rpx;
}

.leave-row {
  padding: 16rpx 0 16rpx 16rpx;
  border-left: 6rpx solid #0f6e56;
  margin-top: 16rpx;
}

.bar-personal { border-left-color: #3d6b99; }
.bar-sick { border-left-color: #c44536; }
.bar-annual { border-left-color: #0f6e56; }
.bar-lieu { border-left-color: #b07d2a; }
.bar-other { border-left-color: #8a8378; }

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row-name {
  font-weight: 600;
}

.row-meta {
  font-size: 26rpx;
  margin-top: 4rpx;
}

.link {
  color: #0f6e56;
  font-size: 24rpx;
}

.row-hover {
  opacity: 0.72;
}

.error-card .retry {
  margin-top: 16rpx;
}
